# Copy to .env for local configuration (optional in development).
# Use a long random value in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# First TPO in-charge account created by `npm run seed` (if missing).
TPOI_EMAIL=tpoi@vjti.ac.in
TPOI_PASSWORD=ChangeMe123!
TPOI_NAME=TPO In-Charge

# Server and database
API_PORT=3001
DB_PATH=server/data/placements.db

# Email (OTP verification / password reset). If SMTP is missing outside production,
# OTP/reset codes are logged to the server console. In production with APP_MODE=launch,
# missing SMTP settings cause startup to fail. Never log codes or SMTP_PASS in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VJTI Placements <no-reply@vjti-placements.local>"
MAX_EMAILS_PER_DAY=150
