{
  "name": "vjti-placements",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.js",
    "dev:full": "concurrently -k -n API,WEB -c cyan,magenta \"npm run dev:api\" \"npm run dev\"",
    "seed": "node server/seed.js",
    "seed:demo": "node server/seed-demo.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/start.js",
    "test": "node --test tests/api.test.js",
    "test:ui": "npm run build && playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "vite": "^7.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
